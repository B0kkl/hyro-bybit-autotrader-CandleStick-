# Copy to .env locally. Never paste API credentials into chat.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_DEMO=true
TRADING_ENABLED=false
TRADING_SYMBOLS=BTCUSDT,ETHUSDT
# Optional: set an estimated adverse slippage in basis points per side for net backtest output.
# Leave blank until you have a defensible estimate; zero assumes no slippage.
BACKTEST_SLIPPAGE_BPS=
